# 复制为 .env 后按需修改密码与端口
APP_PORT=8000

MYSQL_ROOT_PASSWORD=obe_root_2026
MYSQL_DATABASE=obe_attainment
MYSQL_USER=obe_user
MYSQL_PASSWORD=obe_pass_2026

# 生产部署建议修改为随机长字符串
OBE_TOKEN_SECRET=obe-course-attainment-jwt-secret-2026

# 本地开发不启动 Docker 时，留空即默认使用本地 SQLite (backend/attainment.db)
# 如需本地直接连已有 MySQL，取消下一行注释并填写实际地址：
# DATABASE_URL=mysql+pymysql://obe_user:obe_pass_2026@127.0.0.1:3306/obe_attainment
